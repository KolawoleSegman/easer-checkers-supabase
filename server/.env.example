# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:5173

# Supabase: Project -> Connect -> Session pooler -> copy the URI and put your
# database password in place of [YOUR-PASSWORD]. (Use the pooler string, not
# the "Direct connection" one: Render and many hosts are IPv4-only.)
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional
# DB_POOL_MAX=10        # max simultaneous DB connections
# DATABASE_SSL=false    # only for a local Postgres without TLS (auto for localhost)

# Directory for uploaded avatars
DATA_DIR=./data
